# CognoDB
COGNODB_URI=bolt+s://your-cognodb-endpoint
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=your_cognodb_password

# Neo4j
NEO4J_URI=bolt+s://your-neo4j-endpoint
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Memgraph
MEMGRAPH_URI=bolt+s://your-memgraph-endpoint
MEMGRAPH_USERNAME=your_memgraph_username
MEMGRAPH_PASSWORD=your_memgraph_password

# FalkorDB
FALKORDB_HOST=your_falkordb_host
FALKORDB_PORT=your_falkordb_port
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=your_falkordb_password
FALKORDB_TLS=false

# ArangoDB
ARANGODB_URL=https://your-arangodb-endpoint
ARANGODB_USERNAME=root
ARANGODB_PASSWORD=your_arangodb_password
ARANGODB_DATABASE=wikivote
